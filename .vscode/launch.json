{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "cwd": "${workspaceRoot}",
            "executable": "${workspaceFolder}/stm32_vcu",
            "name": "Debug Microcontroller",
            "request": "launch",
            "type": "cortex-debug",
            "servertype": "openocd",
            "configFiles": [
                "/usr/share/openocd/scripts/interface/stlink-v2.cfg",
                "/usr/share/openocd/scripts/board/olimex_stm32_p107.cfg"
            ],
            "svdFile": "/home/murphy/.platformio/platforms/ststm32/misc/svd/STM32F107xx.svd",
        },
        {
            "name": "Debug VCU",
            "type": "cppdbg",
            "request": "launch",
            "miDebuggerPath": "arm-none-eabi-gdb",
            "targetArchitecture": "arm",
            "program": "${workspaceFolder}/stm32_vcu",
            "showDevDebugOutput": true,
            "setupCommands": [
                {
                    "text": "file ${workspaceFolder}/stm32_vcu"
                },
                {
                    "text": "set remote hardware-breakpoint-limit 6"
                },
                {
                    "text": "set remote hardware-watchpoint-limit 4"
                },
                {
                    "text": "target extended-remote localhost:3333"
                },
            ],
            "externalConsole": false,
            "cwd": "${workspaceFolder}"
        }
    ]
}